FROM node:22-bookworm-slim AS build

WORKDIR /app

# Install build tools for native modules
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY . .

# Install and build native modules
RUN pnpm install --frozen-lockfile

RUN pnpm --filter @dcprotocol/core run build \
  && pnpm --filter @dcprotocol/telegram run build


FROM node:22-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV DCP_TELEGRAM_HOST=0.0.0.0
ENV DCP_TELEGRAM_PORT=8423
ENV DCP_TELEGRAM_DATA_DIR=/data

COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/packages/dcp-core ./packages/dcp-core
COPY --from=build /app/packages/dcp-telegram ./packages/dcp-telegram

EXPOSE 8423

CMD ["node", "packages/dcp-telegram/dist/index.js"]
