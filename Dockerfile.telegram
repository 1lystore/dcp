FROM node:22.22.2-bookworm-slim AS build

WORKDIR /app

# Install build tools for native modules
RUN apt-get update && apt-get install -y python3 make g++ && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY . .

# Install and build native modules
RUN pnpm install --frozen-lockfile

# wallet-core must build first: @dcprotocol/core now require()s it at runtime, so
# telegram (which imports core) transitively needs wallet-core's dist present.
RUN pnpm --filter @dcprotocol/wallet-core run build \
  && pnpm --filter @dcprotocol/core run build \
  && pnpm --filter @dcprotocol/telegram run build


FROM node:22.22.2-bookworm-slim AS runtime

WORKDIR /app

ENV NODE_ENV=production
ENV DCP_TELEGRAM_HOST=0.0.0.0
ENV DCP_TELEGRAM_PORT=8423
ENV DCP_TELEGRAM_DATA_DIR=/data

COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/node_modules ./node_modules
# wallet-core is a runtime dependency of core — copy it so the workspace symlink resolves.
COPY --from=build /app/packages/dcp-wallet-core ./packages/dcp-wallet-core
COPY --from=build /app/packages/dcp-core ./packages/dcp-core
COPY --from=build /app/packages/dcp-telegram ./packages/dcp-telegram

EXPOSE 8423

CMD ["node", "packages/dcp-telegram/dist/index.js"]
