{
  "name": "@dcprotocol/vault",
  "version": "2.0.2",
  "description": "DCP - Local vault runtime with CLI and server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dcp": "./dist/cli/index.js",
    "dcp-vault": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server/index.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@dcprotocol/client": "^2.0.1",
    "@dcprotocol/core": "^2.0.0",
    "@dcprotocol/relay-client": "^2.0.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/websocket": "^11.0.0",
    "better-sqlite3": "^11.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "fastify": "^5.2.1",
    "keytar": "^7.9.0",
    "ora": "^8.0.0",
    "pino-pretty": "^13.0.0",
    "prompts": "^2.4.2",
    "tweetnacl": "^1.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.10.2",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1lystore/dcp.git",
    "directory": "packages/dcp-vault"
  },
  "homepage": "https://github.com/1lystore/dcp#readme",
  "bugs": {
    "url": "https://github.com/1lystore/dcp/issues"
  },
  "author": "DCP Protocol",
  "license": "Apache-2.0"
}
