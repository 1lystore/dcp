{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "Default capability for DCP",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "autostart:default",
    "shell:default",
    {
      "identifier": "shell:allow-open",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "cursor://*" },
        { "url": "vscode://*" },
        { "url": "vscode:*" }
      ]
    }
  ]
}
