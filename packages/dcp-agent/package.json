{
  "name": "@dcprotocol/agent",
  "version": "0.2.0",
  "description": "DCP Agent - Lightweight binary for connecting AI agents to vaults via pairing grants",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dcp-agent": "./dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./secrets": {
      "import": "./dist/secrets.js",
      "types": "./dist/secrets.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts",
    "Dockerfile"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/1lystore/dcp.git",
    "directory": "packages/dcp-agent"
  },
  "homepage": "https://github.com/1lystore/dcp#readme",
  "bugs": {
    "url": "https://github.com/1lystore/dcp/issues"
  },
  "scripts": {
    "build": "tsup src/index.ts src/secrets.ts --format esm --dts --clean && chmod +x dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "dcp",
    "agent",
    "vault",
    "ai-agents",
    "mcp",
    "claude",
    "pairing"
  ],
  "author": "DCP Protocol",
  "license": "Apache-2.0",
  "dependencies": {
    "@dcprotocol/core": "workspace:*",
    "@dcprotocol/client": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "^1.4.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18 <23"
  }
}
